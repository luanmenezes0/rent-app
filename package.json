{
  "name": "my-remix-app-0728",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "dev:serve": "binode --require ./mocks -- @remix-run/serve:remix-serve ./build/index.js",
    "format": "prettier --write .",
    "prisma:studio": "prisma studio",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint . --fix",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start:mocks": "binode --require ./mocks -- @remix-run/serve:remix-serve ./build/index.js",
    "test": "vitest",
    "test:e2e:dev": "start-server-and-test dev http://localhost:3000 \"npx cypress open\"",
    "pretest:e2e:run": "npm run build",
    "test:e2e:run": "cross-env PORT=8811 start-server-and-test http://localhost:8811 \"npx cypress run\"",
    "typecheck": "tsc && tsc -p cypress",
    "validate": "run-p \"test -- --run\" lint typecheck test:e2e:run"
  },
  "prettier": {},
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@prisma/client": "^5.19.1",
    "@remix-run/node": "^2.16.8",
    "@remix-run/react": "^2.16.8",
    "@remix-run/serve": "^2.16.8",
    "@remix-run/server-runtime": "^2.16.8",
    "@remix-run/v1-route-convention": "^0.1.4",
    "@remix-validated-form/with-zod": "^2.0.7",
    "bcryptjs": "^3.0.2",
    "dayjs": "^1.11.13",
    "framer-motion": "^11.5.6",
    "isbot": "^3.7.0",
    "prisma": "^5.19.1",
    "puppeteer": "^22.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "remix-validated-form": "^5.1.5",
    "tiny-invariant": "^1.3.3",
    "tsx": "^4.19.4",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@faker-js/faker": "^9.8.0",
    "@remix-run/dev": "^2.16.8",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@testing-library/cypress": "^10.0.3",
    "@types/node": "^22",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.1",
    "autoprefixer": "^10.4.21",
    "binode": "^1.0.5",
    "cookie": "^0.5.0",
    "cross-env": "^7.0.3",
    "cypress": "^14.4.1",
    "eslint": "^9.28.0",
    "eslint-plugin-cypress": "^5.1.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.2.0",
    "happy-dom": "^17.6.3",
    "msw": "^0.47.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "start-server-and-test": "^1.14.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx --require tsconfig-paths/register prisma/seed.ts"
  }
}
